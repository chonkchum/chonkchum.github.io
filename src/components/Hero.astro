---
import { Image } from "astro:assets";
import HeroImg from "@/hero.png";
import { QUOTE, SITE_TITLE } from "@/consts";
---

<div
  class="hero-bg hidden md:block h-screen hero-bg-animate absolute top-0 w-full overflow-hidden opacity-50 transition-opacity duration-500"
>
</div>
<section
  class="min-h-screen !z-[20] relative w-full grid grid-cols-1 md:grid-cols-12 gap-4 items-center px-4 md:px-8"
  id="hero"
>
  <div class="grid place-items-center md:col-span-5 w-full">
    <div class="w-full max-w-lg flex flex-col items-center">
      <div class="text-center">
        <h1 class="font-bold text-5xl xl:text-7xl">{`<${SITE_TITLE} />`}</h1>
        <h2 class="text-xl xl:text-2xl opacity-95 mt-2">
          {QUOTE}
        </h2>
      </div>

      <div
        id="hero-terminal"
        class="mt-6 w-full text-left border-2 border-white rounded-lg overflow-hidden bg-black/95 cursor-text shadow-[0_0_20px_rgba(255,255,255,0.08)]"
      >
        <div
          class="flex items-center justify-between px-4 py-1.5 bg-white/95 text-black select-none"
        >
          <div class="flex space-x-2">
            <div class="w-2.5 h-2.5 rounded-full bg-black"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-black"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-black"></div>
          </div>
          <span id="term-header" class="text-xs font-bold tracking-widest">
            tty1 // 1.048596
          </span>
        </div>

        <div class="p-4 text-xs md:text-sm">
          <div
            id="term-output"
            class="h-48 overflow-y-auto space-y-1 pr-1 text-white/90"
          >
            <div class="text-white/50">
              chonk-arch (tty1) — type 'help' or 'ls'
            </div>
          </div>

          <form
            id="term-form"
            class="mt-2 pt-2 border-t border-white/15 flex items-center gap-2"
          >
            <span id="term-prompt" class="text-white font-bold shrink-0"
              >chonk@arch:~$</span
            >
            <input
              id="term-input"
              type="text"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              class="w-full bg-transparent text-white focus:outline-none caret-white"
            />
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="md:col-span-7 flex justify-end">
    <Image
      id="hero-avatar"
      alt={SITE_TITLE}
      src={HeroImg}
      class="brightness-200 w-full scale-110 md:scale-100 invert origin-right cursor-pointer"
    />
  </div>
</section>

<script is:inline>
  let binarySpeed = 300;
  let binaryTimer = null;

  function startBinaryBg() {
    const hero_bg = document.querySelector(".hero-bg-animate");
    if (!hero_bg) return;
    if (binaryTimer) clearInterval(binaryTimer);
    binaryTimer = setInterval(() => {
      let binaryText = "";
      for (let i = 0; i < 2500; i++) {
        binaryText += Math.floor(Math.random() * 2).toString();
      }
      hero_bg.textContent = binaryText;
    }, binarySpeed);
  }

  startBinaryBg();

  function initHero() {
    const form = document.getElementById("term-form");
    const input = document.getElementById("term-input");
    const output = document.getElementById("term-output");
    const terminalBox = document.getElementById("hero-terminal");
    const headerSpan = document.getElementById("term-header");
    const avatar = document.getElementById("hero-avatar");

    if (!form || !input || !output || terminalBox.dataset.ready === "true")
      return;
    terminalBox.dataset.ready = "true";

    terminalBox.addEventListener("click", () => {
      const sel = window.getSelection();
      if (!sel || sel.toString().length === 0) {
        input.focus();
      }
    });

    let clickCount = 0;
    let clickTimer = null;
    if (avatar) {
      avatar.addEventListener("click", () => {
        clickCount++;
        clearTimeout(clickTimer);
        clickTimer = setTimeout(() => {
          clickCount = 0;
        }, 600);

        if (clickCount === 3) {
          clickCount = 0;
          document.body.classList.add("worldline-shift");
          const newDiv = (Math.random() * 2).toFixed(6);
          if (headerSpan) headerSpan.textContent = `tty1 // ${newDiv}`;
          printLine(
            `[READING STEINER]: World line shifted to ${newDiv}%`,
          );
          setTimeout(() => {
            document.body.classList.remove("worldline-shift");
          }, 450);
        }
      });
    }

    const history = [];
    let historyIdx = -1;

    const files = {
      "beers.cfg": [
        "# Cheers! Mod Brewery Barrel Recipes",
        "hellish_chili_beer = +25% All Dmg, +10 Armor, +15% Incoming Dmg",
        "mushroom_stout     = +40 Max Mana, +15% Magic Dmg",
        "tropical_ipa       = +20% Speed, +20% Attack Speed, +0.3 Regen",
        "corn_beer          = +20% Mining Speed, +20% Building Speed",
      ].join("\n"),
      "spaghetti.log": [
        "[WARN] Conveyor Belt Mk.6 saturation at 99.8%",
        "[INFO] Nuclear Pasta routed to Dimensional Depot",
        "[OK]   Pioneers-Spaghetti-Solver initialized (55 locales loaded)",
      ].join("\n"),
      "worldline.dat":
        "01000101 01101100 00100000 01010000 01110011 01111001 00100000 01001011 01101111 01101110 01100111 01110010 01101111 01101111",
      "todo.txt": [
        "- calibrate 3D printer bed leveling",
        "- flash Arduino固件",
        "- fix 3-star boss spawn rate in Necesse",
      ].join("\n"),
    };

    const beers = [
      "Grain beer (+10 Armor, +10% All Damage)",
      "Strawberry beer (+15% Speed, +20 Max Health)",
      "Hellish chili beer (+25% All Damage, +10 Armor)",
      "Mushroom stout (+40 Max Mana, +15% Magic Damage)",
      "Tropical IPA (+20% Speed, +20% Attack Speed)",
      "Corn beer (+20% Mining Speed, +20% Building Speed)",
    ];

    const bangers = [
      "Linkin Park - Faint (2003)",
      "Daft Punk - Harder, Better, Faster, Stronger (2001)",
      "Gorillaz - Clint Eastwood (2001)",
      "Pendulum - Slam (2005)",
      "The Prodigy - Omen (2009)",
      "Franz Ferdinand - Take Me Out (2004)",
    ];

    const routes = {
      "~": "/",
      home: "/",
      necesse: "/necesse",
      mods: "/necesse",
      blog: "/blog",
      solver: "/spaghetti-solver",
      "spaghetti-solver": "/spaghetti-solver",
    };

    const availableCmds = [
      "help",
      "ls",
      "cat",
      "cd",
      "pwd",
      "whoami",
      "uname",
      "uptime",
      "neofetch",
      "brew",
      "bangers",
      "ficsit",
      "steins",
      "matrix",
      "crt",
      "history",
      "clear",
    ];

    function printLine(html, isCmd = false) {
      const div = document.createElement("div");
      div.className = isCmd
        ? "text-white font-bold mt-1.5"
        : "text-white/80 whitespace-pre-wrap";
      div.innerHTML = html;
      output.appendChild(div);
      output.scrollTop = output.scrollHeight;
    }

    function escapeHtml(str) {
      return str
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }

    function runCommand(raw) {
      const clean = raw.trim();
      if (!clean) return;

      history.push(clean);
      historyIdx = history.length;
      printLine(`chonk@arch:~$ ${escapeHtml(clean)}`, true);

      const parts = clean.split(/\s+/);
      const cmd = parts[0].toLowerCase();
      const arg = parts.slice(1).join(" ");

      switch (cmd) {
        case "clear":
          output.innerHTML = "";
          break;
        case "help":
          printLine(
            [
              "core:   ls, cat <file>, cd <dir>, pwd, whoami, uname, history, clear",
              "system: neofetch, crt, matrix, steins",
              "extras: brew, bangers, ficsit",
            ].join("\n"),
          );
          break;
        case "ls":
          printLine(
            "drwxr-xr-x  necesse/  blog/  spaghetti-solver/\n-rw-r--r--  " +
              Object.keys(files).join("  "),
          );
          break;
        case "pwd":
          printLine("/home/chonkchum");
          break;
        case "whoami":
          printLine("chonkchum — gamer, developer & maker");
          break;
        case "uname":
          printLine("Linux chonk-arch 6.12.4-arch1-1 x86_64 GNU/Linux");
          break;
        case "uptime":
          printLine(
            `up ${Math.floor(performance.now() / 1000)}s, 1 user, load average: 0.08, 0.03, 0.01`,
          );
          break;
        case "cat":
          if (!arg) {
            printLine("usage: cat <filename>");
          } else if (files[arg]) {
            printLine(escapeHtml(files[arg]));
          } else {
            printLine(`cat: ${escapeHtml(arg)}: No such file or directory`);
          }
          break;
        case "cd":
          if (!arg || arg === "~" || arg === "/") {
            printLine("already in /home/chonkchum");
          } else {
            const target = arg.replace(/\/+$/, "").toLowerCase();
            if (routes[target]) {
              printLine(`navigating to ${routes[target]}...`);
              setTimeout(() => {
                window.location.href = routes[target];
              }, 250);
            } else {
              printLine(`cd: ${escapeHtml(arg)}: No such directory`);
            }
          }
          break;
        case "neofetch":
          printLine(
            [
              "   /\\      chonk@arch",
              "  /  \\     ----------",
              " / /\\ \\    OS: Arch Linux x86_64",
              "/ /__\\ \\   Stack: Python, Astro, Godot, Bash",
              "\\/_/\\_\\/   Lab: 3D Printing, Arduino, Docker",
            ].join("\n"),
          );
          break;
        case "brew":
        case "beer":
          printLine(
            `[Brewery Barrel]: ${beers[Math.floor(Math.random() * beers.length)]}`,
          );
          break;
        case "bangers":
          printLine(
            `[mpd]: playing "${bangers[Math.floor(Math.random() * bangers.length)]}"`,
          );
          break;
        case "ficsit":
          printLine(
            "FICSIT Tip #42: Do not sink Somersloops. Use 'cd solver' to fix your factory.",
          );
          break;
        case "steins":
        case "elpsykongroo": {
          const div = (Math.random() * 2).toFixed(6);
          if (headerSpan) headerSpan.textContent = `tty1 // ${div}`;
          printLine(`Divergence: ${div}% — El Psy Kongroo.`);
          break;
        }
        case "matrix": {
          const hero_bg = document.querySelector(".hero-bg-animate");
          if (binarySpeed === 300) {
            binarySpeed = 50;
            if (hero_bg) hero_bg.style.opacity = "0.15";
            startBinaryBg();
            printLine("clock_freq: 50ms (overclocked)");
          } else {
            binarySpeed = 300;
            if (hero_bg) hero_bg.style.opacity = "0.02";
            startBinaryBg();
            printLine("clock_freq: 300ms (default)");
          }
          break;
        }
        case "crt": {
          const isOff = document.body.classList.toggle("crt-off");
          const navBtn = document.getElementById("crt-toggle-btn");
          if (navBtn) navBtn.textContent = isOff ? "[CRT: OFF]" : "[CRT: ON]";
          printLine(`crt_shader: ${isOff ? "disabled" : "enabled"}`);
          break;
        }
        case "history":
          printLine(
            history.map((h, i) => `  ${i + 1}  ${escapeHtml(h)}`).join("\n"),
          );
          break;
        case "sudo":
          printLine("chonk is not in the sudoers file. This incident will be reported.");
          break;
        case "rm":
          printLine("rm: cannot remove '/': Permission denied (nice try)");
          break;
        default:
          printLine(`bash: ${escapeHtml(cmd)}: command not found`);
      }
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      runCommand(input.value);
      input.value = "";
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowUp" && historyIdx > 0) {
        e.preventDefault();
        historyIdx--;
        input.value = history[historyIdx];
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        if (historyIdx < history.length - 1) {
          historyIdx++;
          input.value = history[historyIdx];
        } else {
          historyIdx = history.length;
          input.value = "";
        }
      } else if (e.key === "Tab") {
        e.preventDefault();
        const val = input.value.trim();
        const parts = val.split(/\s+/);
        if (parts.length === 1) {
          const match = availableCmds.find((c) => c.startsWith(parts[0]));
          if (match) input.value = match + " ";
        } else if (parts[0] === "cat") {
          const fileMatch = Object.keys(files).find((f) =>
            f.startsWith(parts[1] || ""),
          );
          if (fileMatch) input.value = `cat ${fileMatch}`;
        } else if (parts[0] === "cd") {
          const dirMatch = Object.keys(routes).find((r) =>
            r.startsWith(parts[1] || ""),
          );
          if (dirMatch) input.value = `cd ${dirMatch}`;
        }
      }
    });
  }

  initHero();
  document.addEventListener("astro:page-load", initHero);
</script>