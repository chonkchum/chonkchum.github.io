---
import { Image } from "astro:assets";
import HeroImg from "@/hero.png";
import { QUOTE, SITE_TITLE } from "@/consts";
---

<div class="hero-bg hidden md:block h-screen hero-bg-animate absolute top-0 w-full overflow-hidden opacity-50"></div>
<section
  class="h-screen !z-[20] relative w-full grid grid-cols-1 md:grid-cols-12 gap-4 items-center"
  id="hero"
>
  <div class="grid place-items-center md:col-span-5">
    <div class="text-center -mt-10">
      <h1 class="font-bold text-5xl xl:text-7xl">{`<${SITE_TITLE} />`}</h1>
      <h2 class="text-xl xl:text-2xl opacity-95 mt-2">
        {QUOTE}
      </h2>
    </div>
  </div>
  
  <div class="md:col-span-7 flex justify-end">
    <Image
      alt="Okabe"
      src={HeroImg}
      class="brightness-200 w-full scale-110 md:scale-100 invert origin-right"
    />
  </div>
</section>

<script is:inline>
  const hero_bg = document.querySelector(".hero-bg-animate");

  setInterval(() => {
    let binaryText = "";
    // Zwiększyłem pętlę z 1000 do 2500, aby binarne tło szczelniej wypełniło ekran
    for (let i = 0; i < 2500; i++) {
      binaryText += Math.floor(Math.random() * 2).toString();
    }
    hero_bg.textContent = binaryText;
  }, 300);
</script>