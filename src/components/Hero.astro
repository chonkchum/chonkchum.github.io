---
import { Image } from "astro:assets";
import HeroImg from "@/hero.png";
import { QUOTE, SITE_TITLE } from "@/consts";
---

<div
  class="hero-bg hidden md:block h-screen hero-bg-animate absolute top-0 w-full overflow-hidden opacity-50 transition-opacity duration-500"
>
</div>
<section
  class="min-h-screen !z-[20] relative w-full grid grid-cols-1 md:grid-cols-12 gap-4 items-center px-4 md:px-8"
  id="hero"
>
  <div class="grid place-items-center md:col-span-5 w-full">
    <div class="w-full max-w-lg flex flex-col items-center">
      <div class="text-center">
        <h1 class="font-bold text-5xl xl:text-7xl">{`<${SITE_TITLE} />`}</h1>
        <h2 class="text-xl xl:text-2xl opacity-95 mt-2">
          {QUOTE}
        </h2>
      </div>

      <div
        id="hero-terminal"
        class="mt-6 w-full text-left border-2 border-white rounded-lg overflow-hidden bg-black/90 shadow-[0_0_20px_rgba(255,255,255,0.12)]"
      >
        <div
          class="flex items-center justify-between px-4 py-1.5 bg-white/95 text-black"
        >
          <div class="flex space-x-2">
            <div class="w-2.5 h-2.5 rounded-full bg-black"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-black"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-black"></div>
          </div>
          <span class="text-xs font-bold tracking-widest">
            chonkchum@crt:~
          </span>
        </div>

        <div class="p-4 text-xs md:text-sm">
          <div
            id="term-output"
            class="h-44 overflow-y-auto space-y-1.5 pr-1 text-white/90"
          >
            <div class="text-white/60">
              CHONK-OS v1.048596 // CRT TERMINAL READY
            </div>
            <div>
              Type <span class="underline">help</span> or click a shortcut below:
            </div>
          </div>

          <form
            id="term-form"
            class="mt-3 pt-2 border-t border-white/20 flex items-center gap-2"
          >
            <span class="text-white font-bold shrink-0">guest@chonkchum:~$</span>
            <input
              id="term-input"
              type="text"
              autocomplete="off"
              spellcheck="false"
              placeholder="try: neofetch, beer, ficsit, bangers..."
              class="w-full bg-transparent text-white focus:outline-none placeholder:text-white/30"
            />
          </form>

          <div class="mt-2.5 flex flex-wrap gap-1.5 text-[11px] text-white/70">
            {
              [
                "help",
                "neofetch",
                "mods",
                "solver",
                "beer",
                "bangers",
                "crt",
                "clear",
              ].map((cmd) => (
                <button
                  type="button"
                  data-cmd={cmd}
                  class="term-chip px-2 py-0.5 border border-white/30 rounded hover:bg-white hover:text-black transition-all"
                >
                  {cmd}
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="md:col-span-7 flex justify-end">
    <Image
      alt={SITE_TITLE}
      src={HeroImg}
      class="brightness-200 w-full scale-110 md:scale-100 invert origin-right"
    />
  </div>
</section>

<script is:inline>
  let binarySpeed = 300;
  let binaryTimer = null;

  function startBinaryBg() {
    const hero_bg = document.querySelector(".hero-bg-animate");
    if (!hero_bg) return;
    if (binaryTimer) clearInterval(binaryTimer);
    binaryTimer = setInterval(() => {
      let binaryText = "";
      for (let i = 0; i < 2500; i++) {
        binaryText += Math.floor(Math.random() * 2).toString();
      }
      hero_bg.textContent = binaryText;
    }, binarySpeed);
  }

  startBinaryBg();

  function initTerminal() {
    const form = document.getElementById("term-form");
    const input = document.getElementById("term-input");
    const output = document.getElementById("term-output");
    const terminalBox = document.getElementById("hero-terminal");
    const chips = document.querySelectorAll(".term-chip");

    if (!form || !input || !output || terminalBox.dataset.ready === "true")
      return;
    terminalBox.dataset.ready = "true";

    const history = [];
    let historyIdx = -1;

    const beers = [
      "Grain beer (+10 Armor, +10% All Damage | +10% Incoming Damage)",
      "Strawberry beer (+15% Speed, +20 Max Health | +10% Incoming Damage)",
      "Hellish chili beer (+25% All Damage, +10 Armor | +15% Incoming Damage)",
      "Mushroom stout (+40 Max Mana, +15% Magic Damage | +10% Incoming Damage)",
      "Tropical IPA (+20% Speed, +20% Attack Speed, +0.3 Regen | +15% Incoming Damage)",
      "Corn beer (+20% Mining Speed, +20% Building Speed | +10% Incoming Damage)",
    ];

    const bangers = [
      "NOW PLAYING: Linkin Park - Numb (2003) [||||||||||----]",
      "NOW PLAYING: Daft Punk - One More Time (2000) [||||||||||||--]",
      "NOW PLAYING: Gorillaz - Feel Good Inc. (2005) [||||||||------]",
      "NOW PLAYING: Pendulum - Propane Nightmares (2008) [|||||||||||---]",
      "NOW PLAYING: Darude - Sandstorm (1999) [||||||||||||||]",
      "NOW PLAYING: Evanescence - Bring Me To Life (2003) [|||||||||-----]",
    ];

    const commands = {
      help: () =>
        [
          "Available commands:",
          "  neofetch - Display ChonkChum system info",
          "  mods     - Necesse Steam Workshop mods",
          "  solver   - Pioneers' Spaghetti Solver",
          "  beer     - Drink a random brew from Cheers! mod",
          "  bangers  - Play a random pre-2010 banger",
          "  ficsit   - FICSIT Inc. pioneer status check",
          "  steins   - Check World Line Divergence Meter",
          "  matrix   - Overclock binary background",
          "  crt      - Toggle CRT scanlines",
          "  clear    - Clear terminal",
        ].join("<br/>"),
      neofetch: () =>
        [
          "  [CHONK-OS]   USER: ChonkChum",
          "  +--------+   ROLE: Gamer, Developer & Maker",
          "  |  >_    |   CODE: Python, Astro, Godot, Bash, HTML",
          "  |        |   LAB:  3D Printing, Arduino, DIY, Docker",
          "  +--------+   OS:   Linux // CRT Phosphor Display",
        ].join("<br/>"),
      mods: () =>
        'Necesse Mods: Cheers!, Desire Paths, Night Owl Trait, Starred Mobs. <a href="/necesse" class="underline font-bold">Open /necesse &rarr;</a>',
      solver: () =>
        'Pioneers\' Spaghetti Solver: Godot factory planner for Satisfactory. <a href="/spaghetti-solver" class="underline font-bold">Open /spaghetti-solver &rarr;</a>',
      beer: () => {
        const pick = beers[Math.floor(Math.random() * beers.length)];
        return `[CHEERS! BREWERY]: You drank ${pick}. Drink responsibly!`;
      },
      bangers: () => {
        const track = bangers[Math.floor(Math.random() * bangers.length)];
        return `[WINAMP v2.91]: ${track}`;
      },
      ficsit: () =>
        "[FICSIT INC.]: Spaghetti levels critical! Please use Pioneers' Spaghetti Solver before feeding Nuclear Pasta into the AWESOME Sink.",
      steins: () => {
        const div = (Math.random() * 2).toFixed(6);
        return `[DIVERGENCE METER]: ${div}% // The Organization is watching. El Psy Kongroo.`;
      },
      elpsykongroo: () =>
        "Ah, it's me. The Organization has infiltrated the terminal. El Psy Kongroo.",
      matrix: () => {
        const hero_bg = document.querySelector(".hero-bg-animate");
        if (binarySpeed === 300) {
          binarySpeed = 60;
          if (hero_bg) hero_bg.style.opacity = "0.14";
          startBinaryBg();
          return "Binary background OVERCLOCKED (60ms).";
        } else {
          binarySpeed = 300;
          if (hero_bg) hero_bg.style.opacity = "0.02";
          startBinaryBg();
          return "Binary background restored to normal (300ms).";
        }
      },
      crt: () => {
        const isOff = document.body.classList.toggle("crt-off");
        return isOff ? "CRT scanlines: OFF" : "CRT scanlines: ON";
      },
      sudo: () =>
        "Nice try! Incident reported to a 3-Star Night Owl settler.",
    };

    function printLine(html, isCmd = false) {
      const div = document.createElement("div");
      div.className = isCmd
        ? "text-white font-bold mt-2"
        : "text-white/85 whitespace-pre-wrap";
      div.innerHTML = html;
      output.appendChild(div);
      output.scrollTop = output.scrollHeight;
    }

    function runCommand(raw) {
      const clean = raw.trim();
      const cmd = clean.toLowerCase();
      if (!cmd) return;

      history.push(clean);
      historyIdx = history.length;
      printLine(`guest@chonkchum:~$ ${clean.replace(/</g, "&lt;")}`, true);

      if (cmd === "clear") {
        output.innerHTML = "";
        return;
      }

      if (cmd.startsWith("sudo ")) {
        printLine(commands.sudo());
        return;
      }

      if (commands[cmd]) {
        printLine(commands[cmd]());
      } else {
        printLine(
          `Command not found: ${cmd.replace(/</g, "&lt;")}. Type <span class="underline">help</span>.`,
        );
      }
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      runCommand(input.value);
      input.value = "";
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowUp" && historyIdx > 0) {
        e.preventDefault();
        historyIdx--;
        input.value = history[historyIdx];
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        if (historyIdx < history.length - 1) {
          historyIdx++;
          input.value = history[historyIdx];
        } else {
          historyIdx = history.length;
          input.value = "";
        }
      }
    });

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const cmd = chip.getAttribute("data-cmd");
        if (cmd) runCommand(cmd);
        input.focus();
      });
    });
  }

  initTerminal();
  document.addEventListener("astro:page-load", initTerminal);
</script>