---
import BaseHead from "@/components/BaseHead.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
} = Astro.props;
---

<html lang="en" class="!overflow-x-hidden">
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class="bg-black text-white tracking-wide !overflow-x-hidden">
    <header class="fixed top-0 w-screen z-[9999]"><Navbar /></header>
    <main class="pt-28 md:pt-20"><slot /></main>
    <footer class="w-screen bottom-0 overflow-x-hidden"><Footer /></footer>

    <script is:inline>
      console.log(
        "%c<ChonkChum />%c\nDivergence: 1.048596%\nThe Organization is watching. El Psy Kongroo.",
        "font-size:20px;font-weight:bold;color:#fff;background:#000;padding:4px 8px;border:2px solid #fff;",
        "font-family:monospace;color:#aaa;padding-top:6px;",
      );

      const konami = [
        "ArrowUp",
        "ArrowUp",
        "ArrowDown",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        "ArrowLeft",
        "ArrowRight",
        "b",
        "a",
      ];
      let konamiIdx = 0;

      window.addEventListener("keydown", (e) => {
        const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
        if (key === konami[konamiIdx]) {
          konamiIdx++;
          if (konamiIdx === konami.length) {
            document.body.classList.toggle("phosphor-green");
            konamiIdx = 0;
          }
        } else {
          konamiIdx = 0;
        }
      });

      let originalTitle = document.title;
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          originalTitle = document.title;
          document.title = "[AFK // TRAMPLING PAUSED]";
        } else {
          document.title = originalTitle;
        }
      });

      function bindScramble() {
        const glyphs = "01アイウエオカキクケコサシスセソ<>/_#=";
        document.querySelectorAll("section h2").forEach((el) => {
          if (el.dataset.scrambleBound) return;
          el.dataset.scrambleBound = "true";
          const orig = el.textContent;

          el.addEventListener("mouseenter", () => {
            let step = 0;
            const interval = setInterval(() => {
              el.textContent = orig
                .split("")
                .map((ch, idx) => {
                  if (ch === " " || idx < step) return orig[idx];
                  return glyphs[Math.floor(Math.random() * glyphs.length)];
                })
                .join("");
              step += 1.5;
              if (step >= orig.length) {
                el.textContent = orig;
                clearInterval(interval);
              }
            }, 25);
          });
        });
      }

      bindScramble();
      document.addEventListener("astro:page-load", bindScramble);
    </script>
  </body>
</html>