---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404: SECTOR NOT FOUND | ChonkChum">
  <section class="min-h-[75vh] w-full grid place-items-center px-4">
    <div
      class="max-w-xl w-full border-2 border-white rounded-lg overflow-hidden bg-black"
    >
      <div
        class="flex items-center justify-between px-4 py-2 bg-white/95 text-black"
      >
        <div class="flex space-x-2">
          <div class="w-3 h-3 rounded-full bg-black"></div>
          <div class="w-3 h-3 rounded-full bg-black"></div>
          <div class="w-3 h-3 rounded-full bg-black"></div>
        </div>
        <span class="text-xs font-bold tracking-widest">
          CRITICAL_ERROR // 404
        </span>
      </div>

      <div class="p-8 text-center space-y-4">
        <h1 class="text-6xl font-bold">{`<404 />`}</h1>
        <p class="text-lg text-white/90">
          SECTOR NOT FOUND IN THIS WORLD LINE.
        </p>
        <p class="text-xs text-white/60">
          Either The Organization intercepted this URL, or a 3-Star Boss
          trampled this path into gravel.
        </p>
        <div class="pt-4">
          <a
            href="/"
            class="inline-block bg-white text-black px-6 py-2.5 rounded font-bold text-sm hover:bg-black hover:text-white border-2 border-white transition-all"
          >
            Return to Base (/home)
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>