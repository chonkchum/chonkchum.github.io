---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "@/layouts/BlogPost.astro";
import { getSteamWorkshopStats } from "@/utils/steam";

export async function getStaticPaths() {
  const posts = await getCollection("necesse");
  const statsMap = await getSteamWorkshopStats(
    posts.map((p) => p.data.workshopId),
  );

  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      steamStats: post.data.workshopId
        ? statsMap[post.data.workshopId]
        : undefined,
    },
  }));
}

const { post, steamStats } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} steamStats={steamStats}>
  <Content />
</BlogPost>