---
import { getCollection } from "astro:content";
import Hero from "@/components/Hero.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Section from "@/components/Section.astro";
import BlogPostCard from "@/components/BlogPostCard.astro";
import Layout from "@/layouts/Layout.astro";
import { KNOWN_TECH, ABOUT_ME } from "@/consts";

// 1. Pobieramy wpisy z obu kolekcji
const blogPosts = await getCollection("blog");
const necessePosts = await getCollection("necesse");

// 2. Łączymy je, sortujemy od najnowszego i ucinamy do 4 sztuk (możesz zmienić liczbę w .slice)
const latestPosts = [...blogPosts, ...necessePosts]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4); 
---

<Layout title="ChonkChum">
  <Hero />
  <Section
    title="Featured Project"
    className={"bg-gradient-to-b from-black/70 from-[5%] to-black via-black"}
  >
    <div
      class="max-w-4xl mx-auto border-2 border-white rounded-lg overflow-hidden bg-white/[0.01]"
    >
      <div
        class="flex items-center justify-between px-4 py-2 bg-white/95 text-black"
      >
        <div class="flex space-x-2">
          <div class="w-3 h-3 rounded-full bg-black"></div>
          <div class="w-3 h-3 rounded-full bg-black"></div>
          <div class="w-3 h-3 rounded-full bg-black"></div>
        </div>
        <span class="text-xs font-bold uppercase tracking-widest">
          GODOT // SATISFACTORY TOOL
        </span>
      </div>
      <div
        class="p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6"
      >
        <div>
          <h3 class="text-2xl font-bold mb-2">{`> Pioneers' Spaghetti Solver`}</h3>
          <p class="text-white/80 text-sm">
            Open-source production calculator and factory planner for
            Satisfactory with full 1.0+ item database and 50+ languages.
          </p>
        </div>
        <a
          href="/spaghetti-solver"
          class="shrink-0 bg-white text-black px-5 py-2.5 rounded font-bold text-sm hover:bg-black hover:text-white border-2 border-white transition-all"
        >
          Explore Project
        </a>
      </div>
    </div>
  </Section>
  <Section
    title="Latest Posts"
    className={"bg-gradient-to-b from-black/70 from-[5%] to-black via-black"}
  >
    <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        latestPosts.map((post) => (
          <BlogPostCard
            slug={post.id}
            title={post.data.title}
            excerpt={post.data.description}
            date={post.data.pubDate}
            collection={post.collection} // 3. Przekazujemy nazwę kolekcji do karty!
          />
        ))
      }
    </div>
  </Section>
  <Section title="Technologies I Know" full_screen={false}>
    <div class="w-full grid place-items-center">
      <div
        class="w-full gap-4 flex flex-wrap px-3 max-w-xl text-lg justify-center"
      >
        {KNOWN_TECH.map((x) => <Breadcrumb title={x} />)}
      </div>
    </div>
  </Section>
  <Section title="About Me">
    <div class="w-full grid place-items-center">
      <div
        class="max-w-4xl text-xl md:text-lg opacity-90 text-center justify-evenly"
      >
        <p>{ABOUT_ME}</p>
      </div>
    </div>
  </Section>
</Layout>